# Credenciales de Spotify API (obligatorias para convertir desde Spotify)
# Obténlas en: https://developer.spotify.com/dashboard
SPOTDL_CLIENT_ID=tu_client_id_aqui
SPOTDL_CLIENT_SECRET=tu_client_secret_aqui

# También se aceptan estas variables como alias:
# SPOTIFY_CLIENT_ID=tu_client_id_aqui
# SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
# CLIENT_ID=tu_client_id_aqui
# CLIENT_SECRET=tu_client_secret_aqui
